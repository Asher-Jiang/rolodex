{
  "name": "rolodex-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/server.js",
    "test": "vitest run",
    "db:migrate": "tsx src/cli/migrate.ts",
    "import:notion": "tsx src/cli/import-notion.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
